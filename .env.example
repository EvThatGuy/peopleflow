# =============================================================================
# PeopleFlow HR — Environment configuration
# =============================================================================
# Copy this file to `.env.local` and fill in real values for development.
# Never commit `.env.local` to source control.
# =============================================================================

# ----- Supabase (required) ---------------------------------------------------
# From https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used for trusted server actions (e.g. accepting an invite,
# bootstrapping a tenant, running scheduled jobs). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- AI providers (optional; mock responses are returned if unset) ---------
# At least one is needed for real assistant responses. The app picks the first
# provider that is configured, in this priority order: Anthropic > OpenAI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ----- App config ------------------------------------------------------------
# The public URL of your deployment. Used for absolute redirects, email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode: when "true", the app skips real auth and signs in as a demo
# Company Admin against the seeded Northwind organization. Useful for screen-
# share demos, local dev, and storybook-style exploration.
NEXT_PUBLIC_DEMO_MODE=true

# ----- Future integrations (placeholders) ------------------------------------
# Real OAuth flows belong in the integrations module; these are not used yet.
GUSTO_CLIENT_ID=
GUSTO_CLIENT_SECRET=
ADP_CLIENT_ID=
ADP_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
PAYCHEX_CLIENT_ID=
PAYCHEX_CLIENT_SECRET=
SLACK_BOT_TOKEN=
GOOGLE_WORKSPACE_DOMAIN=
